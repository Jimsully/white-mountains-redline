# Hosted public application contract.
#
# Full public app base URL. A path prefix is allowed, for example:
# http://localhost:3000
# https://trails.jamesscottsullivan.com
# https://jamesscottsullivan.com/redline
# Approved M8D production value:
# NEXT_PUBLIC_SITE_URL=https://trails.jamesscottsullivan.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Trail repository mode. Production public launch must use `supabase`.
# Omit or use demo only for local prototype/development builds.
TRAIL_REPOSITORY=demo

# Server/build-only public indexing opt-in. Leave false/absent for local,
# Preview, staging, and production before the final human promotion gate.
# If VERCEL_ENV is present, only VERCEL_ENV=production can index.
PUBLIC_INDEXING_ENABLED=false

# Public Supabase browser/auth config. These keys are client-visible and rely on
# database RLS/grants as the security boundary.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Compatibility fallback only. Prefer NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public browser map style. This is build-sensitive public client configuration.
# Production must use a valid HTTPS public provider style URL with no embedded
# credentials and no localhost/private-network endpoint. Provider query keys are
# browser-visible; restrict them by domain with the provider where supported.
NEXT_PUBLIC_MAP_STYLE_URL=

# Do not configure these in the hosted public Next.js application runtime:
# SUPABASE_SERVICE_ROLE_KEY
# RECONCILIATION_ARTIFACT_PATH
# SEGMENT_CONSTRUCTION_ARTIFACT_PATH
# ACTIVITY_MATCHING_ARTIFACT_PATH
# PUBLICATION_ARTIFACT_PATH
# private/admin loader credentials and local importer-only variables
